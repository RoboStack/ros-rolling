diff --git a/ouster-sdk/ouster_client/CMakeLists.txt b/ouster-sdk/ouster_client/CMakeLists.txt
index f17eeb4..c5eee7a 100644
--- a/ouster-sdk/ouster_client/CMakeLists.txt
+++ b/ouster-sdk/ouster_client/CMakeLists.txt
@@ -64,13 +64,24 @@ if(WIN32)
   target_link_libraries(ouster_client PUBLIC ws2_32)
 endif()
 
+# Use the real conda-forge spdlog/fmt instead of the bundled thirdparty
+# copy: mixing the two (e.g. a transitively-found external spdlog for
+# <spdlog/spdlog.h> alongside the vendored-only <spdlog/fmt/bundled/args.h>
+# that logging.cpp includes directly) collides on fmt's template
+# declarations (MSVC C2990/C2955/C2011/...). package.xml already declares
+# <depend>spdlog</depend>, so remove the vendored copy outright rather
+# than fight include-order for it; logging.cpp is patched to include
+# <fmt/args.h> instead of the vendored spdlog/fmt/bundled/args.h.
+file(REMOVE_RECURSE "${CMAKE_CURRENT_SOURCE_DIR}/../thirdparty/spdlog")
+find_package(spdlog REQUIRED CONFIG)
+target_link_libraries(ouster_client PUBLIC spdlog::spdlog)
+
 target_include_directories(ouster_client
   PUBLIC
       $<INSTALL_INTERFACE:include>
       $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
   PRIVATE
       ${OPENSSL_INCLUDE_DIR}
-      $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../thirdparty/spdlog>
 )
 
 target_include_directories(ouster_client SYSTEM

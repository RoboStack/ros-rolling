@@ -187,6 +187,14 @@ set(COMMON_INC_FILES
 )
 set(COMMON_FILES ${COMMON_SRC_FILES} ${COMMON_INC_FILES})
 
+# ament_target_dependencies() was removed from ament_cmake_target_dependencies;
+# link against each dependency's exported <pkg>_TARGETS instead.
+macro(link_ament_dependencies target)
+  foreach(_ament_dep ${ARGN})
+    target_link_libraries(${target} ${${_ament_dep}_TARGETS})
+  endforeach()
+endmacro()
+
 set(AMENT_COMMON_DEPENDENCIES
   rclcpp
   rclcpp_lifecycle
@@ -215,9 +223,7 @@ set(NODE_INC_FILES
 )

+  // intentional "not supported without real threads" sentinel, not a real
+  // failure): rmw_wait() pumps zp_read()/zp_send_keep_alive() itself
+  // instead (see this project's own patch to rmw_wait.c).
+#endif
 
   session->enable_session = true;

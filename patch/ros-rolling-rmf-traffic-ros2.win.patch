+  # instead of libuuid) lives in rpcrt4.
+  target_link_libraries(rmf_traffic_ros2 PRIVATE rpcrt4)
+endif()
+
 target_include_directories(rmf_traffic_ros2
   PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>

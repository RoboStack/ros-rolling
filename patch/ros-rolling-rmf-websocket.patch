diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0368593..32172de 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,12 @@ cmake_minimum_required(VERSION 3.5)

 project(rmf_websocket)

+# websocketpp 0.8.2 needs Asio APIs that Boost's bundled Asio (1.90+) removed.
+# Use the standalone Asio package instead; the source is also updated to its
+# current io_context/asio::post/asio::dispatch API (io_service was removed in
+# standalone Asio 1.33.0, github.com/chriskohlhoff/asio@49fcd034).
+add_compile_definitions(ASIO_STANDALONE)
+
 if(NOT CMAKE_CXX_STANDARD)
   set(CMAKE_CXX_STANDARD 17)
 endif()
